// Gjeçaj Alpine Restaurant Cuisine — restaurant table reservation
// SQLite for the local demo; schema kept clean for a PostgreSQL migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// A dining area (e.g. Indoor / Outdoor / Terrace / Rooftop). Outdoor areas can
// be closed on the fly (bad weather) without deleting reservations.
model Area {
  id               String  @id @default(cuid())
  name             String // "Indoor", "Outdoor", "Terrace"…
  kind             String  @default("indoor") // indoor | outdoor
  isOpen           Boolean @default(true) // PERMANENT status: true = active, false = inactive (seasonal/indefinite)
  weatherDependent Boolean @default(false)
  priority         Int     @default(0) // lower = preferred for "no preference"
  sortOrder        Int     @default(0)

  tables       RestaurantTable[]
  closures     AreaClosure[]
  combinations TableCombination[]

  @@index([kind])
}

// A temporary closure of an area for a specific date/time window (rain, cold,
// private event…). Distinct from the permanent isOpen status: it only affects
// the given window and never disables future dates.
model AreaClosure {
  id            String   @id @default(cuid())
  areaId        String
  startDateTime DateTime
  endDateTime   DateTime
  reason        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  area Area @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@index([areaId])
  @@index([startDateTime])
  @@index([endDateTime])
}

model RestaurantTable {
  id        String   @id @default(cuid())
  name      String // e.g. "T1", "Terrace 3"
  seats     Int
  section   String // free-text label within an area (e.g. "Window", "Bar")
  areaId    String?
  shape     String   @default("square") // square | round | rect
  // Floor-map position on a 12 x 8 grid (mobile-first, scales responsively)
  x         Int      @default(0)
  y         Int      @default(0)
  w         Int      @default(2)
  h         Int      @default(2)
  rotation  Int      @default(0) // degrees: 0 | 90 | 180 | 270 (visual only)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  area               Area?                    @relation(fields: [areaId], references: [id])
  reservations       Reservation[]
  reservationTables  ReservationTable[]
  combinationMembers TableCombinationMember[]

  @@index([section])
  @@index([areaId])
}

// A predefined physical grouping of two or more real tables that can be pushed
// together to seat a larger party. Combinations are curated by staff — the
// engine never invents them. All member tables must share the same area.
model TableCombination {
  id        String   @id @default(cuid())
  name      String
  areaId    String
  minSeats  Int?
  maxSeats  Int
  priority  Int      @default(0) // lower = preferred when capacities tie
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  area    Area                     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  members TableCombinationMember[]

  @@index([areaId])
  @@index([isActive])
}

model TableCombinationMember {
  id            String @id @default(cuid())
  combinationId String
  tableId       String

  combination TableCombination @relation(fields: [combinationId], references: [id], onDelete: Cascade)
  table       RestaurantTable  @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([combinationId, tableId]) // a table cannot appear twice in one combination
  @@index([tableId])
}

// Join between a reservation and the one-or-more tables it occupies. This is the
// authoritative record of which tables a booking holds (a single-table booking
// has exactly one row; a combined booking has several).
model ReservationTable {
  id            String @id @default(cuid())
  reservationId String
  tableId       String

  reservation Reservation     @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  table       RestaurantTable @relation(fields: [tableId], references: [id])

  @@unique([reservationId, tableId])
  @@index([tableId])
  @@index([reservationId])
}

model Customer {
  id             String   @id @default(cuid())
  firstName      String
  lastName       String
  phone          String
  whatsappNumber String?
  email          String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  reservations Reservation[]

  @@index([phone])
}

model Reservation {
  id            String   @id @default(cuid())
  cancelToken   String   @unique @default(cuid()) // used for the self-service cancel link in emails
  tableId       String
  customerId    String
  startDateTime DateTime
  endDateTime   DateTime
  partySize     Int
  status        String   @default("Confirmed") // Confirmed | Seated | Completed | Cancelled | NoShow
  notes         String?
  source        String   @default("Online") // Online | Walk-in | Phone
  requestedArea String   @default("no_preference") // indoor | outdoor | no_preference
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  table         RestaurantTable    @relation(fields: [tableId], references: [id])
  customer      Customer           @relation(fields: [customerId], references: [id])
  notifications Notification[]
  tables        ReservationTable[]

  @@index([tableId, startDateTime])
  @@index([startDateTime])
  @@index([customerId])
  @@index([status])
}

// Restaurant-wide opening hours; supports multiple periods per day (lunch / dinner shifts).
model OpeningHour {
  id        String  @id @default(cuid())
  dayOfWeek Int // 0 = Sunday ... 6 = Saturday
  startTime String // "HH:mm"
  endTime   String // "HH:mm"
  isActive  Boolean @default(true)

  @@index([dayOfWeek])
}

// Restaurant-wide closures (single day or a range).
model Closure {
  id        String   @id @default(cuid())
  startDate DateTime
  endDate   DateTime
  reason    String?
}

model Notification {
  id            String   @id @default(cuid())
  reservationId String
  type          String // BookingConfirmation | Reminder24h | Reminder2h | Cancellation | Reschedule | Completed | NoShow
  channel       String   @default("WhatsApp")
  status        String   @default("Sent")
  message       String
  recipient     String
  createdAt     DateTime @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
}

model RestaurantSetting {
  id                     String   @id @default(cuid())
  name                   String
  tagline                String?
  phone                  String?
  whatsapp               String?
  address                String?
  email                  String?
  logoUrl                String? // absolute public HTTPS URL to the logo (dashboard + emails)
  websiteUrl             String?
  brandColor             String? // optional hex, e.g. "#b85c38"
  currency               String   @default("EUR")
  turnDurationMinutes    Int      @default(120) // how long a table is held per booking
  bookingInterval        Int      @default(30) // slot granularity, minutes
  seatingBuffer          Int      @default(15) // minutes between bookings on the same table
  maxPartySize           Int      @default(12)
  // Capacity caps per time slot (0 = no cap; capacity then limited only by tables)
  maxReservationsPerSlot Int      @default(0)
  maxCoversPerSlot       Int      @default(0)
  timezone               String   @default("Europe/Tirane")
  // Automatic reminders
  reminder24hEnabled Boolean @default(true)
  reminder2hEnabled  Boolean @default(false)
  reminderText       String? // optional extra line appended to reminder emails
  updatedAt              DateTime @updatedAt
}

// Per-time overrides for the slot caps, e.g. "max 4 reservations at 18:00".
// dayOfWeek = null applies to every day.
model SlotLimit {
  id              String  @id @default(cuid())
  dayOfWeek       Int?
  time            String // "HH:mm" (reservation start time)
  areaKind        String? // null = whole restaurant; "indoor" | "outdoor" = that area only
  maxReservations Int
  maxCovers       Int?

  @@index([time])
}
