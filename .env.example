# PostgreSQL (Neon). Use the POOLED connection string for the app runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# DIRECT (non-pooled) connection — only needed locally for `prisma migrate`.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Public base URL — used to build the cancel link inside confirmation emails.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email (SMTP). If set, real confirmation/cancellation emails are sent to the
# guest and the owner. If empty, the app runs in demo mode (nothing delivered).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="info@example.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="Restaurant <info@example.com>"

# Admin dashboard login
ADMIN_PASSWORD="choose-a-strong-password"
AUTH_SECRET="random-32+-char-secret-for-signing-sessions"

# Server timezone — slot times are built in this zone (IMPORTANT on Vercel, which is UTC).
TZ="Europe/Tirane"

# Restrict which sites may call the reservation API (comma-separated). "*" for demo.
ALLOWED_ORIGINS="*"
