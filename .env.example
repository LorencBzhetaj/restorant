# Database (SQLite for the demo). For production use PostgreSQL (Neon / Vercel Postgres).
DATABASE_URL="file:./dev.db"

# Public base URL — used to build the cancel link inside confirmation emails.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email (SMTP). If these are set, real confirmation/cancellation emails are sent
# to the guest and the owner. If left empty, the app runs in DEMO mode and only
# records notifications (nothing is actually delivered).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Terrazza <reservations@terrazza.al>"
